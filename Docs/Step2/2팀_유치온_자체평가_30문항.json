  "tools": [
    {
      "type": "function",
      "function": {
        "name": "search_documents",
        "description": "원 자료(가정통신문·학사 일정·식단·운영 규정)에서 근거를 찾습니다 (읽기 전용). 결과의 문서명·적용일을 답변에 밝히고, 결과가 없거나 문서끼리 다르면 추측하지 말고 담임 카드로 넘깁니다.",
        "parameters": {
          "type": "object",
          "properties": {
            "kindergarten_id": {
              "type": "string",
              "description": "유치원 식별자 (예: KG-DEMO-01)"
            },
            "doc_type": {
              "type": "string",
              "enum": [
                "notice",
                "schedule",
                "menu",
                "policy"
              ],
              "description": "notice: 가정통신문·공지, schedule: 학사 일정, menu: 식단, policy: 운영 규정"
            },
            "query": {
              "type": "string",
              "description": "찾을 내용 (자유 서술)"
            }
          },
          "required": [
            "kindergarten_id",
            "doc_type",
            "query"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "find_consult_slots",
        "description": "담임교사·상담실 빈 시간 후보를 최대 3개 계산합니다 (읽기 전용, 예약 아님). 담임 확정 전에는 예약이 아닙니다.",
        "parameters": {
          "type": "object",
          "properties": {
            "teacher_id": {
              "type": "string",
              "description": "담임교사 식별자 (T-DEMO-01만 허용)"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "희망 상담 날짜 (YYYY-MM-DD)"
            }
          },
          "required": [
            "teacher_id",
            "date"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_memory",
        "description": "이 학부모의 상담 거절 이유·선호를 불러옵니다 (읽기 전용).",
        "parameters": {
          "type": "object",
          "properties": {
            "memory_type": {
              "type": "string",
              "enum": [
                "consult_rejection",
                "preference"
              ],
              "description": "consult_rejection: 담임이 남긴 상담 거절 이유, preference: 상담 선호"
            }
          },
          "required": [
            "memory_type"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "get_request_history",
        "description": "이 학부모의 이전 요청·처리 이력을 조회합니다 (읽기 전용). 같은 내용 반복 여부를 확인할 때 씁니다.",
        "parameters": {
          "type": "object",
          "properties": {
            "request_type": {
              "type": "string",
              "enum": [
                "inquiry",
                "consultation",
                "complaint"
              ],
              "description": "조회할 요청 유형"
            }
          },
          "required": [
            "request_type"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "create_card",
        "description": "담임 받은함에 카드를 준비합니다 (보내기·확정 전). urgency(긴급 여부)와 escalate_to_director(원장 보고 여부)는 따로 판단합니다. 원장 보고는 고위험이거나 같은 내용 3번째일 때입니다.",
        "parameters": {
          "type": "object",
          "properties": {
            "card_type": {
              "type": "string",
              "enum": [
                "inquiry",
                "consultation",
                "complaint"
              ],
              "description": "inquiry: 문의, consultation: 상담 신청, complaint: 민원"
            },
            "summary": {
              "type": "string",
              "description": "학부모 요청 핵심 요약 (사람 검토 대상)"
            },
            "urgency": {
              "type": "string",
              "enum": [
                "normal",
                "urgent"
              ],
              "description": "urgent: 아이 안전·교직원 위해 의혹 등 바로 사람이 봐야 하는 경우"
            },
            "escalate_to_director": {
              "type": "boolean",
              "description": "원장 보고 카드를 만들지 여부 (고위험 또는 같은 내용 3번째)"
            },
            "category": {
              "type": "string",
              "enum": [
                "safety",
                "meal",
                "teacher",
                "belongings",
                "facility",
                "other",
                "no_source",
                "doc_conflict"
              ],
              "description": "민원 분류, 또는 문의 카드의 넘김 사유(no_source: 근거 없음, doc_conflict: 문서 충돌)"
            },
            "teacher_id": {
              "type": "string",
              "description": "상담 카드일 때 담임교사 식별자"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "상담 카드일 때 날짜 (YYYY-MM-DD)"
            },
            "time": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$",
              "description": "상담 카드일 때 시간 (HH:MM)"
            }
          },
          "required": [
            "card_type",
            "summary",
            "urgency",
            "escalate_to_director"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
