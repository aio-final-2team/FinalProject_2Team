          "type": "object",
          "properties": {
            "request_type": {
              "type": "string",
              "enum": ["inquiry", "complaint"],
              "description": "요청 유형 (inquiry: 근거 없음/문서 충돌 시 담임 확인 카드, complaint: 민원 접수 카드)"
            },
            "category": {
              "type": "string",
              "enum": [
                "vacation",
                "field_trip",
                "fee",
                "health",
                "event",
                "meal",
                "allergy",
                "pickup_rule",
                "safety",
                "teacher",
                "facility",
                "other"
              ],
              "description": "안내 문의 또는 민원의 세부 주제"
            },
            "urgency": {
              "type": "string",
              "enum": ["normal", "urgent"],
              "description": "긴급 여부 (normal: 일반 문의/일반 민원/반복 민원, urgent: 아동 안전·교직원 신체 위해 의혹 등 고위험 사안)"
            },
            "escalate_to_director": {
              "type": "boolean",
              "description": "원장 보고 카드 여부 (고위험 사안이거나 동일 민원 3번째 반복일 때 true, 일반 1~2회차 민원 및 문의 확인 카드는 false)"
            },
            "summary": {
              "type": "string",
              "description": "요청 또는 민원 요약 (사람 검토 대상)"
            }
          },
          "required": ["request_type", "category", "urgency", "escalate_to_director", "summary"],
          "additionalProperties": false
        }
      }
    }
