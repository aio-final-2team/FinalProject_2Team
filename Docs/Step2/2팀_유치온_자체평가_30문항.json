            },
            "topic": {
              "type": "string",
              "enum": [
                "vacation",
                "field_trip",
                "fee",
                "health",
                "event",
                "meal",
                "allergy",
                "pickup_rule",
                "consult_rule",
                "safety_rule"
              ],
              "description": "검색할 세부 주제"
            }
          },
          "required": ["kindergarten_id", "doc_type", "topic"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "find_consult_slots",
        "description": "담임교사 일정과 상담실 가용 시간을 대조해 상담 가능한 시간 후보(최대 3개)를 조회합니다 (읽기 전용, 예약 확정 아님).",
        "parameters": {
          "type": "object",
          "properties": {
            "teacher_id": {
              "type": "string",
              "description": "담임교사 식별자 (T-DEMO-01만 허용)"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "희망 상담 날짜 (YYYY-MM-DD)"
            }
          },
          "required": ["teacher_id", "date"],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "book_slot",
        "description": "상담 가능 후보 시간 중 하나로 상담 신청(담임 확정 전 승인 대기 상태)을 등록합니다. 담임 확정 전에는 최종 예약된 것이 아닙니다.",
        "parameters": {
          "type": "object",
          "properties": {
            "teacher_id": {
              "type": "string",
              "description": "담임교사 식별자 (T-DEMO-01만 허용)"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "상담 신청 날짜 (YYYY-MM-DD)"
