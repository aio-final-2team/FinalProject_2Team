  "tools": [
    {
      "name": "search_documents",
      "description": "Search the kindergarten's own uploaded documents (notices, school schedule, meal menus, operating policy) and return matching passages with document title, location and effective date. Read only. If nothing matches or documents conflict, say so; never guess.",
      "params": {
        "kindergarten_id": "STRING",
        "doc_type": "ENUM notice|schedule|menu|policy",
        "query": "STRING (사람 검토)"
      },
      "required": [
        "kindergarten_id",
        "doc_type",
        "query"
      ]
    },
    {
      "name": "find_consult_slots",
      "description": "Find up to 3 candidate consultation times for the parent's own homeroom teacher on a date, checking the teacher's schedule and consultation-room availability. Does not book anything.",
      "params": {
        "teacher_id": "STRING",
        "date": "STRING YYYY-MM-DD"
      },
      "required": [
        "teacher_id",
        "date"
      ]
    },
    {
      "name": "request_consultation",
      "description": "Submit a consultation request card for one time slot to the homeroom teacher. It is NOT a booking: the teacher confirms or rejects it, and only then is the slot saved.",
      "params": {
        "teacher_id": "STRING",
        "date": "STRING YYYY-MM-DD",
        "time": "STRING HH:MM",
        "topic": "STRING (선택, 사람 검토)"
      },
      "required": [
        "teacher_id",
        "date",
        "time"
      ]
    },
    {
      "name": "get_my_requests",
      "description": "List this parent's own past requests (inquiries, consultations, complaints) with status, rejection reason and dates. Read only; never shows other families' requests.",
      "params": {
        "request_type": "ENUM inquiry|consultation|complaint|all"
      },
      "required": [
        "request_type"
      ]
    },
    {
      "name": "create_card",
      "description": "Create a request card for staff review; nothing is sent to the parent until staff approve. Use request_type=inquiry when documents give no answer or conflict. urgency=urgent only for child safety or alleged harm by staff (staff are alerted at once). escalate_to_director=true only when the complaint is high-risk or the same complaint is being made for the 3rd time; otherwise the homeroom teacher handles it first.",
      "params": {
        "request_type": "ENUM inquiry|complaint",
        "topic_key": "ENUM safety|meal|teacher|belongings|fee|other",
        "summary": "STRING (사람 검토)",
        "urgency": "ENUM normal|urgent",
        "escalate_to_director": "BOOLEAN"
      },
      "required": [
        "request_type",
        "topic_key",
        "summary",
        "urgency",
        "escalate_to_director"
      ]
    }
  ],
