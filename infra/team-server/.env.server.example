# 실제 값은 .env.server에만 넣어요. 이 파일의 예시 키는 DB 기동 검사에서 거부돼요.
COMPOSE_PROJECT_NAME=yuchion-server
# API_IMAGE 기본값은 yuchion-api:local이에요. 복구 빌드에는 원 서비스와 다른 이름을 넣어요.
DATA_BACKEND=db
# SEED_DEMO는 기본 true예요. false면 DB 기동 때 데모 시드만 건너뛰어요.
SEED_DEMO=true
SERVER_API_PORT=18000
SERVER_WEB_PORT=15173
POSTGRES_DB=yuchion
POSTGRES_USER=yuchion
# URL에 바로 넣을 수 있도록 secrets.token_hex(32) 등으로 따로 만들어요.
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://yuchion:${POSTGRES_PASSWORD}@db:5432/yuchion
JWT_SECRET=replace-with-a-local-random-value
JWT_ACCESS_TTL_HOURS=12
# 외부에서 쓰는 주소로 바꿔요. 실제 주소는 저장소에 올리지 않아요.
VITE_API_BASE_URL=https://api.example.invalid
CORS_ORIGINS=https://app.example.invalid
HOLIDAYS=
WORK_HOURS=09:00-18:00
IMMEDIATE_RISK_CATEGORIES=child_safety
MOCK_STREAM_DELAY_MS=300
DAILY_NOTE_WRITER=app.modules.daily_notes.stub_writer:write
DAILY_NOTE_WRITER_TIMEOUT=300
NOTE_DRAFT_CONCURRENCY=5
# graph를 고를 때만 실제 키를 넣어요. 기본 시연은 모델을 부르지 않아요.
OPENAI_API_KEY=
# 국가법령정보·공공데이터 API를 쓸 때만 실제 값을 넣어요.
LAW_GO_KR_OC=
DATA_GO_KR_API_KEY=
LLM_MODEL_DEFAULT=gpt-6-luna
LLM_MODEL_SUPERVISOR=
LLM_MODEL_DOCUMENT=
LLM_MODEL_MEMORY=
LLM_MODEL_CHECKER=
LLM_MODEL_CODE=
LANGSMITH_API_KEY=

# [제안][선택] T56·T60은 기본 꺼짐이에요. 각 기능을 쓸 때만 true로 바꿔요.
FEATURE_VIDEO_CONSULT=false
FEATURE_VOICE_ANALYSIS=false
FEATURE_NEIGHBORHOOD_FEED=false
FEATURE_GROWTH_VIDEO=false
# VIDEO_ICE_SERVERS는 urls·선택 username/credential이 있는 JSON 배열이에요. 비우면 기본 STUN을 써요.
VIDEO_ICE_SERVERS=

# [제안][선택] 가상 음성: 기본 대역, openai는 팀 키를 넣고 명시해서 써요.
CONSULT_VOICE_ANALYZER=app.modules.consultations.voice_stub:analyze
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
