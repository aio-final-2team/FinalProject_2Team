# Local development values only. Replace these on your own machine; never commit real secrets.
DATA_BACKEND=mock
# 팀 QA 서버에서만 true 또는 1. 운영에서는 켜지 않아요.
QA_TOOLS=false
QA_PASSWORD=
# SEED_DEMO는 기본 true예요. false면 DB 기동 때 데모 시드만 건너뛰어요.
SEED_DEMO=true
# API_IMAGE 기본값은 yuchion-api:local이에요. 복구 빌드에는 원 서비스와 다른 이름을 넣어요.
RUN_IN=api
# DB worker mode: RUN_IN=worker docker compose --profile worker up --build
WORKER_CONCURRENCY=4
CELERY_BROKER_URL=redis://redis:6379/0
API_PORT=8000
POSTGRES_PORT=15432
POSTGRES_DB=yuchion
POSTGRES_USER=yuchion
POSTGRES_PASSWORD=yuchion-local
DATABASE_URL=postgresql://yuchion:yuchion-local@db:5432/yuchion
# DATABASE_URL is the container address; host tools use localhost:POSTGRES_PORT.
VITE_API_BASE_URL=http://localhost:8000
JWT_SECRET=replace-with-a-local-random-value
# DB mode requires a separate random key of at least 32 bytes (this example is rejected).
JWT_ACCESS_TTL_HOURS=12
# Mock API (contracts/mock_api/README.md). HOLIDAYS = comma-separated YYYY-MM-DD
CORS_ORIGINS=http://localhost:5173
HOLIDAYS=
WORK_HOURS=09:00-18:00
IMMEDIATE_RISK_CATEGORIES=child_safety
MOCK_STREAM_DELAY_MS=300
DAILY_NOTE_WRITER=app.modules.daily_notes.stub_writer:write
DAILY_NOTE_WRITER_TIMEOUT=300
REQUEST_AGENT=app.modules.requests.agent_stub:run_request
# 1이면 REQUEST_AGENT가 graph_agent일 때 협업 그래프를 써요.
REQUEST_COLLAB_GRAPH=
NOTE_DRAFT_CONCURRENCY=5
OPENAI_API_KEY=
# Public API credentials (National Law Information Center / data.go.kr).
LAW_GO_KR_OC=
DATA_GO_KR_API_KEY=
# Model per agent role (Docs/Step2/API_설계_문서.md 8). Empty role keys fall back to LLM_MODEL_DEFAULT.
# Exception: empty SUPERVISOR (keyword rules only) or MEMORY (no tone learning) disables that model.
LLM_MODEL_DEFAULT=gpt-6-luna
LLM_MODEL_SUPERVISOR=
LLM_MODEL_DOCUMENT=
LLM_MODEL_MEMORY=
LLM_MODEL_CHECKER=
LLM_MODEL_CODE=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
# Public APIs (tools/public_apis/README.md). Each teammate uses their own key.
LAW_GO_KR_OC=
DATA_GO_KR_API_KEY=

# 가상 사진 파일 저장 폴더예요. Compose API 전용 볼륨을 같은 위치에 연결해요.
MEDIA_DIR=/media
# 문의 답변은 기본 모의 초안. graph면 자료 AI가 근거를 확인해 초안을 만들어요.
ANSWER_WRITER=stub
# 답변 근거를 자료 찾는 AI가 도구로 모아요(agent). fixed면 질문 문장으로 문서 4종을 고정 검색해요.
ANSWER_GATHER=agent
# 비우면 임베딩을 쓰지 않아요. BAAI/bge-m3를 쓰려면 별도 패키지가 필요해요.
EMBEDDING_MODEL=
# 임베딩 패키지를 API 이미지에 넣으려면 1로 두고 다시 빌드해요.
INSTALL_EMBEDDING=0
