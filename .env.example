# Local development values only. Replace these on your own machine; never commit real secrets.
POSTGRES_DB=yuchion
POSTGRES_USER=yuchion
POSTGRES_PASSWORD=yuchion-local
DATABASE_URL=postgresql://yuchion:yuchion-local@db:5432/yuchion
VITE_API_BASE_URL=http://localhost:8000
JWT_SECRET=replace-with-a-local-random-value
JWT_ACCESS_TTL_HOURS=12
# Mock API (contracts/mock_api/README.md). HOLIDAYS = comma-separated YYYY-MM-DD
CORS_ORIGINS=http://localhost:5173
HOLIDAYS=
MOCK_STREAM_DELAY_MS=300
OPENAI_API_KEY=
# Model per agent role (Docs/Step2/API_설계_문서.md 8). Empty role keys fall back to LLM_MODEL_DEFAULT.
LLM_MODEL_DEFAULT=gpt-6-luna
LLM_MODEL_SUPERVISOR=
LLM_MODEL_DOCUMENT=
LLM_MODEL_MEMORY=
LLM_MODEL_CHECKER=
LLM_MODEL_CODE=
LANGSMITH_API_KEY=
