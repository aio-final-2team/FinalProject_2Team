# 화면이 부르는 백엔드 주소. 비워 두면 같은 주소의 /api/v1로 부른다(개발 서버에선 아래 프록시를 탄다).
VITE_API_BASE_URL=
# 시연 계정 버튼. 최종 제출본에서는 false
VITE_DEMO_ACCOUNTS=true
# 개발 서버(npm run dev)가 /api/v1을 넘길 곳. 비우면 로컬 FastAPI(http://127.0.0.1:8000).
# 팀 서버의 진짜 DB·AI 응답을 보면서 만들려면: API_PROXY_TARGET=https://3-34-13-40.sslip.io
API_PROXY_TARGET=
